<div class="ci-narrator-inner">
  <header class="ci-narrator-header">
    <div class="ci-narrator-symbol"><img src="systems/casos-insolitos/assets/Simbolo-mini.webp" alt=""></div>
    <div><span class="ci-narrator-kicker">CASOS INSÓLITOS</span><h1>Recursos do Narrador</h1><p>Rolagens rápidas para conduzir a investigação</p></div>
  </header>

  <section class="ci-narrator-section">
    <h2><i class="fa-solid fa-dice"></i> Testes</h2>
    <div class="ci-narrator-grid two">
      <button data-roll="test"><i class="fa-solid fa-dice-two"></i><span>Teste Padrão</span><small>2d6 · sucesso ≥ 9</small></button>
      <button data-roll="specialist"><i class="fa-solid fa-dice-four"></i><span>Especialização</span><small>4d6 · mantém os 2 melhores</small></button>
    </div>
  </section>

  <section class="ci-narrator-section">
    <h2><i class="fa-solid fa-skull-crossbones"></i> Dano</h2>
    <div class="ci-narrator-grid four">
      <button class="damage-low" data-roll="damage" data-formula="1d6" data-label="Baixa Periculosidade"><strong>1d6</strong><span>Baixa</span></button>
      <button class="damage-medium" data-roll="damage" data-formula="2d6" data-label="Média Periculosidade"><strong>2d6</strong><span>Média</span></button>
      <button class="damage-high" data-roll="damage" data-formula="3d6" data-label="Alta Periculosidade"><strong>3d6</strong><span>Alta</span></button>
      <button class="damage-extreme" data-roll="damage" data-formula="4d6" data-label="Altíssima Periculosidade"><strong>4d6</strong><span>Altíssima</span></button>
    </div>
  </section>

  <section class="ci-narrator-section">
    <h2><i class="fa-solid fa-brain"></i> Sanidade e Presença</h2>
    <div class="ci-narrator-grid three">
      <button data-roll="sanity" data-formula="1d6" data-label="Abalo Forte"><strong>1d6</strong><span>Abalo Forte</span></button>
      <button data-roll="sanity" data-formula="2d6" data-label="Abalo Profundo"><strong>2d6</strong><span>Abalo Profundo</span></button>
      <button data-roll="sanity" data-formula="3d6" data-label="Abalo Devastador"><strong>3d6</strong><span>Abalo Devastador</span></button>
    </div>
    <div class="ci-narrator-subtitle">Presença Insólita</div>
    <div class="ci-narrator-grid four">
      <button data-roll="presence" data-label="Mundano"><strong>0</strong><span>Mundano</span></button>
      <button data-roll="presence" data-formula="1d6" data-label="Abalo Forte"><strong>1d6</strong><span>Abalo Forte</span></button>
      <button data-roll="presence" data-formula="2d6" data-label="Abalo Profundo"><strong>2d6</strong><span>Abalo Profundo</span></button>
      <button data-roll="presence" data-formula="3d6" data-label="Abalo Devastador"><strong>3d6</strong><span>Abalo Devastador</span></button>
    </div>
  </section>

  <section class="ci-narrator-section">
    <h2><i class="fa-solid fa-triangle-exclamation"></i> Condições e Recuperação</h2>
    <div class="ci-narrator-grid three">
      <button data-roll="insanity"><i class="fa-solid fa-brain"></i><span>Insanidade Temporária</span><small>2d6 · efeito + duração</small></button>
      <button data-roll="recovery" data-formula="1d6" data-label="Insanidade Temporária"><i class="fa-regular fa-clock"></i><span>Recuperação da Insanidade</span><small>1d6 minutos</small></button>
      <button data-roll="recovery" data-formula="3d6" data-label="Morrendo"><i class="fa-solid fa-heart-pulse"></i><span>Tempo Morrendo</span><small>3d6 minutos</small></button>
    </div>
  </section>

  <section class="ci-narrator-section compact-section">
    <h2><i class="fa-solid fa-magnifying-glass"></i> Outros</h2>
    <div class="ci-narrator-grid two">
      <button data-roll="frenzy"><i class="fa-solid fa-hourglass-half"></i><span>Frenesi Investigativo</span><small>2d6 · dias de dedicação</small></button>
      <button data-roll="order"><i class="fa-solid fa-list-ol"></i><span>Ordem de Ações</span><small>Exibe a ordem completa no chat</small></button>
    </div>
  </section>
</div>
