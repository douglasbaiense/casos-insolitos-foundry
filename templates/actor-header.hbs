<header class="ci-header">
  <div class="ci-brand">
    <div class="ci-sigil" aria-hidden="true"><img src="systems/casos-insolitos/assets/Simbolo-mini.webp" alt="Símbolo de Casos Insólitos"></div>
    <div>
      <div class="ci-kicker">CASOS INSÓLITOS</div>
      <h1>Ficha do Investigador</h1>
      <p>RPG de investigação paranormal</p>
    </div>
  </div>
  <div class="ci-portrait-frame" title="Selecionar imagem do personagem">
    <img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="Imagem de {{actor.name}}">
    <span class="ci-portrait-hint"><i class="fa-solid fa-image"></i></span>
  </div>
  <div class="ci-header-stamp">
    <span class="ci-stamp">CONFIDENCIAL</span>
  </div>
</header>
